{
  "name": "open-ftms-ble",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-dependency Web Bluetooth library for FTMS fitness machines (e.g. Tacx Flux 2) and BLE heart-rate monitors",
  "keywords": [
    "ftms",
    "web-bluetooth",
    "bluetooth",
    "smart-trainer",
    "indoor-bike",
    "heart-rate",
    "tacx"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pranen/openftms.git",
    "directory": "packages/open-ftms-ble"
  },
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/web-bluetooth": "^0.0.22",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
